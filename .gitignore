# Upstream payload — proprietary, not redistributable. See LEGAL.md.
# Restore it locally with: scripts/vendor-upstream.sh <Aurora_SDTool.zip>
/vendor/AuroraLauncher
/vendor/*.so
/share/icons/hicolor/256x256/apps/aurora-sdtool.png
/docs/upstream/*.txt

# Build output
/dist/

# Arch packaging leftovers
/packaging/arch/pkg/
/packaging/arch/src/
/packaging/arch/*.pkg.tar.*
/packaging/arch/*.tar.gz
/packaging/arch/aurora-sdtool/

# Flatpak
/packaging/flatpak/.flatpak-builder/
/.flatpak-builder/
/packaging/flatpak/build/
/packaging/flatpak/repo/

# AppImage
/packaging/appimage/AppDir/
*.AppImage

# Claude Code's per-machine permission state. A shared .claude/settings.json
# would still be tracked; only the .local. variant is personal.
/.claude/settings.local.json

# Editors and desktops
*.swp
*~
.idea/
.vscode/
.DS_Store
